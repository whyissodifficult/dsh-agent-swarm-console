  "keywords": [
    "dsh",
    "deepseek-harness",
    "delivery-gate",
    "verification",
    "evidence",
    "contract"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whyissodifficult/dsh-agent-swarm-console.git",
    "directory": "plugin"
  },
  "license": "MIT",
  "author": "郑志阳 (Walk in the white)",
  "homepage": "https://github.com/whyissodifficult/dsh-agent-swarm-console",
  "bugs": {
    "url": "https://github.com/whyissodifficult/dsh-agent-swarm-console/issues"
  },
  "engines": {
    "node": ">=20.3"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "policies",
